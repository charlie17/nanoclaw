# Daystrom NanoClaw Configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Authentication (API-key mode — default launch mode) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# To switch to subscription mode, comment out API key and uncomment:
# CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME

# --- Assistant Identity ---
ASSISTANT_NAME=Daystrom

# --- Telegram ---
TELEGRAM_BOT_TOKEN=REPLACE_ME

# --- Sender Allowlist (JT's Telegram user ID) ---
ALLOWED_SENDERS=REPLACE_ME

# --- Logging ---
LOG_LEVEL=info

# --- Container Limits ---
MAX_CONCURRENT_CONTAINERS=5
CONTAINER_TIMEOUT=1800000
IDLE_TIMEOUT=1800000

# --- Bridge Auth (API-key mode — simple bearer token behind Tailscale) ---
BRIDGE_AUTH_TOKEN=REPLACE_WITH_RANDOM_SECRET
